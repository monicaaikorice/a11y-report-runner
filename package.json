{
  "name": "ally-report-runner",
  "version": "1.0.0",
  "description": "Standalone Playwright and axe-core accessibility reporting CLI",
  "bin": {
    "ally-report-runner": "./scripts/a11y-report.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "scripts/"
  ],
  "scripts": {
    "a11y:scan": "node scripts/a11y-report.mjs",
    "a11y:install:chromium": "playwright install chromium",
    "check": "node --check scripts/a11y-report.mjs && node --check scripts/axe-config.mjs && node --check test/axe-config.test.mjs && node --check scripts/run-config.mjs && node --check test/run-config.test.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monicaaikorice/a11y-report-runner.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/monicaaikorice/a11y-report-runner/issues"
  },
  "homepage": "https://github.com/monicaaikorice/a11y-report-runner#readme",
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
