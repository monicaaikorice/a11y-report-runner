  "bugs": {
    "url": "https://github.com/monicaaikorice/a11y-report-runner/issues"
  },
  "homepage": "https://github.com/monicaaikorice/a11y-report-runner#readme",
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
